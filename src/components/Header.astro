---
const links = [
  { label: 'INICIO', href: '#inicio' },
  { label: 'PROYECTOS', href: '#proyectos' },
  { label: 'SOBRE MÍ', href: '#sobre-mi' },
  { label: 'CONTACTO', href: '#contacto' },
  { label: 'REDES', href: '#redes' },
  { label: 'ES / EN', href: '#' },
];
---

<header class="site-header" id="inicio">
  <a class="header__brand" href="#inicio">VERÓNICA</a>
  <nav class="header__nav" aria-label="Navegación principal">
    <ul class="header__nav-list">
      {links.map(({ label, href }) => (
        <li class="header__nav-item">
          <a class="header__nav-link" href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 75px;
    padding-inline: 29px;
    padding-block: 6px 0;
    background: #f3e9d8;
    color: #1e1c1c;
    border-bottom: 1px solid #aeb1b1;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .header__brand {
    flex-shrink: 0;
    font-family: var(--font-brand);
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
  }

  .header__nav {
    flex: 0 1 580px;
    min-width: 0;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .header__nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 37px;
  }

  .header__nav-item:first-child,
  .header__nav-item:last-child {
    flex: 0.68;
  }

  .header__nav-item + .header__nav-item {
    border-left: 1px solid #aeb1b1;
  }

  .header__nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 37px;
    padding-inline: 8px;
    font-family: var(--font-nav);
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  .header__nav-link:hover {
    opacity: 0.65;
  }

  @media (max-width: 760px) {
    .site-header {
      gap: 16px;
      padding-inline: 20px;
    }

    .header__brand { font-size: 23px; }
    .header__nav-link { padding-inline: 6px; font-size: 16px; }
  }

  @media (max-width: 580px) {
    .site-header {
      flex-wrap: wrap;
      height: auto;
      min-height: 75px;
      gap: 14px;
      padding: 18px 12px 12px;
    }

    .header__nav { flex-basis: 100%; }
    .header__nav-link { padding-inline: 3px; font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__nav-link { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const motion = gsap.matchMedia();

  motion.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.timeline({ defaults: { ease: 'power3.out', clearProps: 'transform,opacity' } })
      .from('.header__brand', { y: -12, opacity: 0, duration: 0.6 })
      .from('.header__nav-item', {
        y: -10,
        opacity: 0,
        duration: 0.5,
        stagger: 0.06,
      }, '-=0.35');
  });
</script>
